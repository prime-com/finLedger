# ===================================================================
# FinLedger Environment Configuration Example
# Copy this file to .env or export these variables in your deployment dashboard.
# ===================================================================

# Database Connection (Neon / PostgreSQL)
# For local PostgreSQL:
DB_URL=jdbc:postgresql://localhost:5432/finledger_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# For Neon Serverless PostgreSQL (copy from Neon Dashboard Connection Details):
# DB_URL=jdbc:postgresql://ep-your-project-id.us-east-2.aws.neon.tech/finledger_db?sslmode=require
# DB_USERNAME=your_neon_username
# DB_PASSWORD=your_neon_password

# Server Port (Render sets $PORT dynamically; defaults to 8080 locally)
PORT=8080

# Production Deployed Frontend URL for CORS (e.g., your Vercel deployment)
FRONTEND_URL=https://your-finledger-app.vercel.app

# Additional Allowed Origins (comma-separated if needed)
CORS_ALLOWED_ORIGINS=http://localhost:4200
