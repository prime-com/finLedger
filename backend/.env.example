# ===================================================================
# FinLedger Environment Configuration Example
# Copy this file to .env or export these variables in your terminal shell.
# ===================================================================

# PostgreSQL Database Connection
DB_URL=jdbc:postgresql://localhost:5432/finledger_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Server Port (optional, defaults to 8080)
SERVER_PORT=8080

# CORS Allowed Origins (optional, defaults to http://localhost:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200
